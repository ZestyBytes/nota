{
  "name": "nota",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Roughly 8am and 8pm UK time; UTC is fixed here so it drifts an hour
  // either side of the clocks changing (BST/GMT) until nudged manually.
  "triggers": {
    "crons": ["0 7 * * *", "0 19 * * *"]
  }
  // PUSH_KV (KV namespace binding, id "nota-push") is currently set only
  // in the Cloudflare dashboard. Wrangler treats this file as the source
  // of truth for bindings on each deploy, so until the namespace id is
  // added here as a "kv_namespaces" entry, a future deploy could drop
  // that binding. Pending the id from the dashboard.
}
