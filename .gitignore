.impeccable/

# Obsidian's own settings folder, which it recreates per device: pane layout,
# recent files, appearance, plugin caches. Committing it means every device
# fights every other device, and a phone vault regenerates it constantly.
.obsidian/

# macOS and iOS leave these in folders they touch
.DS_Store
._*

node_modules/

# local build output
dist/

# scratch screenshots from local verification
/c*.png
/*.mjs
