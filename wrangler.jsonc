{
  "name": "nota",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Roughly 8am and 8pm UK time; UTC is fixed here so it drifts an hour
  // either side of the clocks changing (BST/GMT) until nudged manually.
  "triggers": {
    "crons": ["0 7 * * *", "0 19 * * *"]
  },
  "kv_namespaces": [
    { "binding": "PUSH_KV", "id": "cad276b2afb74b84a9cdfa77c9dda845" }
  ]
}
